  <files>
    <file src="$upstreamPackageRoot$\lib\**\*" target="lib" />
    <file src="$upstreamPackageRoot$\runtimes\**\*" target="runtimes" />
    <file src="$upstreamPackageRoot$\build\**\*" target="build" />
    <file src="$upstreamPackageRoot$\buildTransitive\**\*" target="buildTransitive" />
    <!-- NuGet auto-imports build assets only when their base name matches the package ID. -->
    <file src="$upstreamPackageRoot$\build\libplctag.NativeImport.props" target="build\IoT-Driver.ABPlcRx.NativeImport.props" />
    <file src="$upstreamPackageRoot$\build\libplctag.NativeImport.targets" target="build\IoT-Driver.ABPlcRx.NativeImport.targets" />
